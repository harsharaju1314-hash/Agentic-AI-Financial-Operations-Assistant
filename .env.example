# ==========================================
# Agentic AI Financial Operations Assistant
# Environment Configuration Template
# ==========================================

# Application Settings
APP_NAME="Agentic AI Financial Operations Assistant"
APP_ENV=development
APP_PORT=8000
DEBUG=True
API_KEY=finops-secret-key-development

# Database Settings
# For local SQLite development:
DATABASE_URL=sqlite:///./financial_ops.db
# For PostgreSQL in Docker / Production:
# DATABASE_URL=postgresql://finops_user:finops_password@postgres:5432/finops_db

# Agent & LLM Configuration
# Set OPENAI_API_KEY to use real OpenAI LLM models (gpt-4o / gpt-4o-mini).
# If empty, the system automatically runs with the robust built-in Deterministic Financial Intelligence engine.
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.1

# Machine Learning / Fraud Detection
MODEL_PATH=ml/models/fraud_isolation_forest.joblib
FRAUD_CONTAMINATION=0.03
HIGH_RISK_THRESHOLD=0.75
MEDIUM_RISK_THRESHOLD=0.40

# AWS S3 Configuration (Optional for cloud sync)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
S3_BUCKET_NAME=finops-transactions-archive

# Streamlit Dashboard Settings
STREAMLIT_PORT=8501
BACKEND_API_URL=http://localhost:8000
